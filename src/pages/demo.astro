---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PlayButton from '../components/PlayButton.astro';
import GameDemo from '../components/GameDemo.astro';
---

<BaseLayout
  title="Plinko — демо бесплатно"
  description="Plinko демо: играть бесплатно, потренироваться без депозита."
>
  <PageHero
    title="Plinko — демо-режим"
    lead="Играйте бесплатно прямо на странице. На реальные деньги переходите только с готовым лимитом по банкроллу."
  />
  <article class="content">
    <div class="container">
      <GameDemo title="Plinko+" />

      <p>
        В демо можно понять механику множителей и риск без ставок на реальный баланс.
      </p>
      <p><PlayButton /></p>
    </div>
  </article>
</BaseLayout>
